# Pinned versions for eval/codequality (sourced by run.sh; recorded in summary.json).
# Node packages (intelephense, yaml) are pinned exactly in package.json/package-lock.json,
# PHP packages (nikic/php-parser) in php/composer.json/composer.lock.
CQ_MODEL="gpt-6-luna"
CQ_EFFORT="none"                 # lowest effort gpt-6-luna accepts ("minimal" is rejected by the API)
CQ_CODEX_MIN_VERSION="0.160.0"   # flags used: --ignore-user-config --ephemeral --output-schema, model_instructions_file, include_*=false, mcp default_tools_approval_mode
CQ_CONCURRENCY_DEFAULT=16
CQ_CONCURRENCY_MAX=32
CQ_BUDGET_USD_DEFAULT=5
# Owner-approved rule catalogue (rules.yaml). summary.json records the actual version + sha256 and
# whether they match these values; the tests fail when rules.yaml changes without updating them.
CQ_CATALOGUE_VERSION="1.0.0"
CQ_CATALOGUE_SHA256="7c806f0eccc222ee80fdb908287bca368845fdb5e94705159b98fe2df2ee11c7"
