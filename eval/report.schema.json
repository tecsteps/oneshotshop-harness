{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineers.dev/schemas/oneshotshop-v2-report.json",
  "title": "#OneShotShop v2 run report (single input for the website step)",
  "description": "Built by ./oneshotshop evaluate (step report) from runs/<branch>/. Sub-documents owned by other steps (gate, tools, testplan, insights) are embedded as-is and only checked for their type here; their own formats are defined by those steps.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "branch", "generatedAt", "run", "playwright", "gate", "tools", "testplan", "perf", "insights", "human", "evaluation", "costs", "artifacts"],
  "$defs": {
    "nullableObject": { "type": ["object", "null"] },
    "nullableString": { "type": ["string", "null"] },
    "nullableNumber": { "type": ["number", "null"] },
    "stepStatus": { "enum": ["pending", "running", "done", "failed", "skipped"] }
  },
  "properties": {
    "schemaVersion": { "const": 1 },
    "branch": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}-[a-z0-9-]+$" },
    "generatedAt": { "type": "string", "format": "date-time" },
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent", "agentTitle", "agentVersion", "modelLabel", "modelSlug", "status", "image", "spec", "prompt", "limits", "wallTime", "sessions", "result", "pushed", "mcp", "tools"],
      "properties": {
        "agent": { "type": "string", "minLength": 1 },
        "agentTitle": { "$ref": "#/$defs/nullableString" },
        "agentVersion": { "$ref": "#/$defs/nullableString" },
        "modelLabel": { "type": "string", "minLength": 1 },
        "modelSlug": { "type": "string", "minLength": 1 },
        "status": { "type": "string" },
        "image": { "type": "object", "required": ["id"], "properties": { "tag": { "type": "string" }, "id": { "type": "string" } } },
        "spec": { "type": "object", "required": ["commit"], "properties": { "source": { "type": "string" }, "branch": { "type": "string" }, "commit": { "type": "string" }, "tree": { "type": "string" } } },
        "prompt": { "type": "object", "required": ["sha256"], "properties": { "source": { "type": "string", "description": "README.md#Prompt @ <spec commit>" }, "file": { "$ref": "#/$defs/nullableString" }, "sha256": { "type": "string" }, "text": { "type": "string" } } },
        "limits": { "$ref": "#/$defs/nullableObject" },
        "wallTime": { "$ref": "#/$defs/nullableObject" },
        "sessions": { "type": "integer", "minimum": 0 },
        "result": { "$ref": "#/$defs/nullableObject" },
        "pushed": { "type": "boolean" },
        "mcp": { "$ref": "#/$defs/nullableObject" },
        "tools": { "$ref": "#/$defs/nullableObject" }
      }
    },
    "playwright": {
      "type": "object",
      "additionalProperties": false,
      "required": ["pinnedMcp", "run", "evaluator"],
      "description": "Playwright MCP + Chromium used by the building agent (container) and by the evaluator (host); pinnedMcp comes from lib/versions.sh.",
      "properties": {
        "pinnedMcp": { "$ref": "#/$defs/nullableString" },
        "run": {
          "type": ["object", "null"],
          "properties": { "playwrightMcp": { "$ref": "#/$defs/nullableString" }, "playwrightCore": { "$ref": "#/$defs/nullableString" }, "chromium": { "$ref": "#/$defs/nullableString" }, "available": { "type": ["boolean", "null"] } }
        },
        "evaluator": {
          "type": ["object", "null"],
          "properties": { "playwrightMcp": { "$ref": "#/$defs/nullableString" }, "chromium": { "$ref": "#/$defs/nullableString" }, "preflightOk": { "type": ["boolean", "null"] } }
        }
      }
    },
    "gate": { "$ref": "#/$defs/nullableObject" },
    "tools": { "$ref": "#/$defs/nullableObject" },
    "testplan": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["pass", "score", "perArea", "results"],
      "properties": {
        "pass": { "type": "integer", "minimum": 1 },
        "score": { "$ref": "#/$defs/nullableObject" },
        "perArea": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["area", "total", "byResult"],
            "properties": {
              "area": { "type": "string" },
              "total": { "type": "integer", "minimum": 0 },
              "byResult": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 0 } }
            }
          }
        },
        "results": { "type": ["array", "null"] }
      }
    },
    "perf": {
      "type": ["object", "null"],
      "description": "From runs/<branch>/perf/summary.json (eval/perf): headline comparison numbers and the detected stack, embedded as-is.",
      "additionalProperties": false,
      "required": ["headline", "stack"],
      "properties": { "headline": { "$ref": "#/$defs/nullableObject" }, "stack": { "$ref": "#/$defs/nullableObject" } }
    },
    "insights": { "$ref": "#/$defs/nullableObject" },
    "human": {
      "type": "object",
      "additionalProperties": false,
      "required": ["impressionComplete", "impressionMarkdown", "screenshots"],
      "properties": {
        "impressionComplete": { "type": "boolean" },
        "impressionMarkdown": { "$ref": "#/$defs/nullableString" },
        "screenshots": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["file", "path", "caption"],
            "properties": {
              "file": { "type": "string", "pattern": "^[0-9]{2}-[a-z0-9-]+\\.(png|jpe?g|webp)$" },
              "path": { "type": "string" },
              "caption": { "$ref": "#/$defs/nullableString" }
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["status"],
        "properties": {
          "status": { "$ref": "#/$defs/stepStatus" },
          "started": { "$ref": "#/$defs/nullableString" },
          "finished": { "$ref": "#/$defs/nullableString" },
          "duration_secs": { "$ref": "#/$defs/nullableNumber" },
          "cost_usd": { "$ref": "#/$defs/nullableNumber" },
          "error": { "$ref": "#/$defs/nullableString" },
          "note": { "$ref": "#/$defs/nullableString" }
        }
      }
    },
    "costs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["evaluationUsd", "byStep"],
      "properties": {
        "evaluationUsd": { "type": "number", "minimum": 0 },
        "byStep": { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
      }
    },
    "artifacts": {
      "type": "object",
      "description": "Paths relative to the harness root; null when the artefact does not exist.",
      "additionalProperties": { "$ref": "#/$defs/nullableString" }
    }
  }
}
