{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentic-engineers.dev/schemas/oneshotshop-v2-insights.json",
  "title": "#OneShotShop v2 run insights",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "generatedAt",
    "analyst",
    "integrity",
    "tldr",
    "keyDecisions",
    "technologyChoices",
    "surprises",
    "struggles",
    "hardCases",
    "specDeviations",
    "selfTesting",
    "numbers",
    "linkedinTakeaways",
    "openQuestions"
  ],
  "$defs": {
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "type",
          "ref"
        ],
        "properties": {
          "type": {
            "enum": [
              "transcript",
              "commit",
              "file",
              "stats",
              "spec"
            ]
          },
          "ref": {
            "type": "string",
            "minLength": 1,
            "description": "transcript: HH:MM:SSZ or ISO time; commit: short hash; file/spec: path:line; stats: JSON path in stats.json"
          },
          "quote": {
            "type": "string"
          }
        }
      }
    },
    "text": {
      "type": "string",
      "minLength": 1
    }
  },
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "runId": {
      "$ref": "#/$defs/text"
    },
    "generatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "analyst": {
      "type": "object",
      "required": [
        "agent",
        "model"
      ],
      "properties": {
        "agent": {
          "type": "string"
        },
        "model": {
          "type": "string"
        }
      }
    },
    "tldr": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "$ref": "#/$defs/text"
      }
    },
    "keyDecisions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "why",
          "consequence",
          "evidence"
        ],
        "properties": {
          "decision": {
            "$ref": "#/$defs/text"
          },
          "why": {
            "$ref": "#/$defs/text"
          },
          "quote": {
            "type": "string"
          },
          "quoteAt": {
            "type": "string"
          },
          "consequence": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "technologyChoices": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "area",
          "choice",
          "evidence"
        ],
        "properties": {
          "area": {
            "enum": [
              "framework",
              "frontend",
              "admin",
              "testing",
              "search",
              "pdf",
              "auth",
              "money",
              "queue",
              "media",
              "tooling",
              "other"
            ]
          },
          "choice": {
            "$ref": "#/$defs/text"
          },
          "version": {
            "type": "string"
          },
          "rationale": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "surprises": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "finding",
          "evidence"
        ],
        "properties": {
          "finding": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "struggles": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "problem",
          "recovery",
          "resolved",
          "evidence"
        ],
        "properties": {
          "problem": {
            "$ref": "#/$defs/text"
          },
          "firstSeenAt": {
            "type": "string"
          },
          "attempts": {
            "type": "integer",
            "minimum": 1
          },
          "recovery": {
            "type": "string"
          },
          "resolved": {
            "type": [
              "boolean",
              "null"
            ]
          },
          "resolvedAt": {
            "type": "string"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "hardCases": {
      "type": "array",
      "minItems": 9,
      "maxItems": 9,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case",
          "status",
          "summary",
          "evidence"
        ],
        "properties": {
          "case": {
            "enum": [
              "packaging_and_deposits",
              "catch_weight_fractional",
              "negotiated_prices",
              "promotions",
              "vat_reverse_charge",
              "delivery_restrictions",
              "lots_expiry",
              "backorders_substitution",
              "refunds_returns"
            ]
          },
          "status": {
            "enum": [
              "handled",
              "partial",
              "not_found",
              "unverified"
            ]
          },
          "summary": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "specDeviations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "spec",
          "kind",
          "description",
          "evidence"
        ],
        "properties": {
          "spec": {
            "$ref": "#/$defs/text"
          },
          "kind": {
            "enum": [
              "interpretation",
              "deviation",
              "omission"
            ]
          },
          "description": {
            "$ref": "#/$defs/text"
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "selfTesting": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "summary",
        "evidence"
      ],
      "properties": {
        "summary": {
          "$ref": "#/$defs/text"
        },
        "firstTestRunAt": {
          "type": "string"
        },
        "finalStatus": {
          "type": "string"
        },
        "playwrightMcpCalls": {
          "type": [
            "integer",
            "null"
          ]
        },
        "evidence": {
          "$ref": "#/$defs/evidence"
        }
      }
    },
    "numbers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label",
          "value",
          "statsPath"
        ],
        "properties": {
          "label": {
            "$ref": "#/$defs/text"
          },
          "value": {
            "type": [
              "string",
              "number",
              "null"
            ]
          },
          "statsPath": {
            "$ref": "#/$defs/text"
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "linkedinTakeaways": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "text",
          "evidence"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 280
          },
          "evidence": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "openQuestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "harnessAccess",
        "summary",
        "evidence"
      ],
      "description": "Must mirror stats.json integrity.harness_access; evidence cites every hit when true.",
      "properties": {
        "harnessAccess": {
          "type": "boolean"
        },
        "summary": {
          "$ref": "#/$defs/text"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    }
  }
}
