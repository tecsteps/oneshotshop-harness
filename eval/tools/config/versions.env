# Pinned tool versions for eval/tools (sourced by run.sh). Docker images are pinned by tag AND
# digest (multi-arch index digest), packages by exact version. Change a pin only deliberately:
# results are comparable only between runs scanned with the same pins (summary.json records them).

# 1. SonarQube Community Build (server) + scanner
SONARQUBE_IMAGE="sonarqube:26.9.0.129388-community@sha256:c0f1160bccfa435db4168c2d7df69af3c3ea7bfeb87395613014048fb33a68c1"
SONAR_SCANNER_IMAGE="sonarsource/sonar-scanner-cli:12.2.0.4256_8.1.0@sha256:a3f4215076706c95a17a68c19322ee916e40a3acd081a8c1a1e839e0194afa57"
# 2. Larastan / PHPStan (composer-required into a throwaway copy of the app)
LARASTAN_VERSION="3.12.2"
PHPSTAN_VERSION="2.2.16"
PHPSTAN_LEVELS="5 8"
# 3. Semgrep CE (rules vendored in config/semgrep, see config/semgrep/vendor.sh)
SEMGREP_IMAGE="semgrep/semgrep:1.179.0@sha256:93963d9295a366f59e4850127b1550400ee7b388f04fe144e4a1f6325d96e01b"
# 4. Trivy
TRIVY_IMAGE="aquasec/trivy:0.75.0@sha256:af6acf9a6b85dfe389a1941505c0ce9efef52a4719635e1a962f022a3d855daa"
# 5. OWASP ZAP (baseline = passive scan only)
ZAP_IMAGE="zaproxy/zap-stable:2.17.0@sha256:781a2bdaea47324e7bab583e2263f21d257b0aee61ed51521a5be45f5f5081ef"
ZAP_SPIDER_MINUTES=2
# 6. PhpMetrics (same major/minor as the v1 website data: 2.9.1)
PHPMETRICS_VERSION="2.9.1"
# 7. Gitleaks
GITLEAKS_IMAGE="zricethezav/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f"
# 8. Laravel Pint
PINT_VERSION="1.32.1"
# 9. Agent's own tests: run image + PCOV
PCOV_VERSION="1.0.12"
# 10./11. Browser tools (axe-core via Playwright, Lighthouse) on Playwright's Chromium
# Playwright: taken from lib/versions.sh (PLAYWRIGHT_DEPS_VERSION) so build, gate and eval use one version;
# this is only the fallback if that file is missing.
PLAYWRIGHT_VERSION_FALLBACK="1.63.0"
AXE_PLAYWRIGHT_VERSION="4.13.0"
AXE_CORE_VERSION="4.13.0"
LIGHTHOUSE_VERSION="13.5.0"
LIGHTHOUSE_RUNS=3
# LOC per language (Debian bookworm package)
CLOC_VERSION="1.96-1"
