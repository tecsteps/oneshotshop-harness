# Copy to .env (git-ignored). The harness does NOT inject credentials by default: you log in
# to the agent yourself inside the run shell. Only with `./oneshotshop <agent> ... --with-credentials`
# is exactly ONE of the agent's declared variables (agents/<agent>/agent.conf) passed in.
CLAUDE_CODE_OAUTH_TOKEN=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
CURSOR_API_KEY=
OPENROUTER_API_KEY=

# Deployment (deploy/, later). Never passed into any run, gate or evaluation container.
FORGE_TOKEN=
